# GitHub (https://github.com/settings/tokens)
# Fine-grained token with public repository read access (or classic token with public_repo scope)
GITHUB_TOKEN=

# Cloudflare Turnstile (https://dash.cloudflare.com -> Turnstile)
# For local dev, use Cloudflare's test keys: site=1x00000000000000000000AA secret=1x0000000000000000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Resend (https://resend.com)
RESEND_API_KEY=
RESEND_FROM=Contact Form <noreply@yourdomain.com>
RESEND_TO=you@yourdomain.com

# SOPS/age (optional — only needed to decrypt resume.yml locally)
# Generate a keypair with: age-keygen
AGE_SECRET_KEY=

# --- Feature flags (build-time; default enabled, set to false to disable) ---
# Decorative circuit-board traces (nav sidebar, profile circle, unlock page)
NEXT_PUBLIC_CIRCUIT_TRACES=
# Professional work section: home page section, nav item, and /work pages (404 when disabled)
NEXT_PUBLIC_WORK_SECTION=

# Gated /work pages (resume + certifications) auth backend
# Set CF_ACCESS_ENABLED=true to use Cloudflare Access; otherwise the built-in
# password gate below is used.
CF_ACCESS_ENABLED=

# --- Cloudflare Access (used when CF_ACCESS_ENABLED=true) ---
# Zero Trust → Access → Applications
# Set to true locally to bypass auth; leave unset in production
CF_ACCESS_BYPASS=
# Team domain: yourteam.cloudflareaccess.com
CF_ACCESS_TEAM_DOMAIN=
# Application Audience tag from the Access application settings
CF_ACCESS_AUD=

# --- Self-managed password gate (used when CF_ACCESS_ENABLED is not true) ---
# Password required to unlock the gated pages
SITE_ACCESS_PASSWORD=
# Secret used to sign the session cookie — generate with: openssl rand -base64 32
AUTH_SESSION_SECRET=
